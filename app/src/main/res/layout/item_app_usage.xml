<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/card_background_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- App icon -->
            <ImageView
                android:id="@+id/itemAppIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- App name -->
                <TextView
                    android:id="@+id/itemAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="App Name"/>

                <!-- Total data -->
                <TextView
                    android:id="@+id/itemAppData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/accent_color"
                    android:layout_marginTop="2dp"
                    android:text="0 KB"/>

            </LinearLayout>

            <!-- Rank badge -->
            <TextView
                android:id="@+id/itemAppRank"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/background_dark"
                android:background="@drawable/badge_bg"
                android:text="#1"/>

        </LinearLayout>

        <!-- Usage bar -->
        <ProgressBar
            android:id="@+id/itemAppBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:progressDrawable="@drawable/usage_bar_drawable"
            android:max="100"
            android:progress="50"/>

        <!-- ↓ RX  |  ↑ TX breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/itemAppLiveDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textSize="10sp"
                android:textColor="@color/meter_red"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/itemAppRx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="@color/text_secondary_dark"
                android:text="↓ 0 KB"/>

            <TextView
                android:id="@+id/itemAppTx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="@color/text_secondary_dark"
                android:gravity="end"
                android:text="↑ 0 KB"/>

            <TextView
                android:id="@+id/btnRestrictApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restrict"
                android:textSize="11sp"
                android:textColor="@color/meter_red"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
